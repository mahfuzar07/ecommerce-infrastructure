# =============================================================================
# Root Production Environment Configuration Template
# Copy this file to .env.production (or use per-app .env.production files)
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Domain & Routing Settings
# -----------------------------------------------------------------------------
DOMAIN=yourdomain.com
STOREFRONT_DOMAIN=yourdomain.com
PORTAL_DOMAIN=admin.yourdomain.com
API_DOMAIN=api.yourdomain.com

# -----------------------------------------------------------------------------
# 2. PostgreSQL Configuration
# -----------------------------------------------------------------------------
POSTGRES_USER=ecommerce_prod_user
POSTGRES_PASSWORD=replace_with_a_very_strong_password_32chars
POSTGRES_DB=ecommerce_prod_db
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?schema=public

# -----------------------------------------------------------------------------
# 3. Redis Configuration
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# 4. NestJS Backend API (.env.production)
# -----------------------------------------------------------------------------
NODE_ENV=production
PORT=5000
API_PREFIX=api/v1
API_PUBLIC_URL=https://api.yourdomain.com
STOREFRONT_URL=https://yourdomain.com
PORTAL_URL=https://admin.yourdomain.com

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com,https://admin.yourdomain.com

# JWT Authentication
JWT_SECRET=replace_with_a_random_jwt_secret_64chars
JWT_EXPIRATION=1d
JWT_REFRESH_SECRET=replace_with_a_random_jwt_refresh_secret_64chars
JWT_REFRESH_EXPIRATION=7d

# Cloud Storage (AWS S3 or Cloudflare R2)
STORAGE_PROVIDER=S3
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=your-bucket-name
STORAGE_ACCESS_KEY=your_access_key
STORAGE_SECRET_KEY=your_secret_key
STORAGE_CDN_URL=https://pub-your-bucket-id.r2.dev

# Meta / Social Integration (Optional)
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

# SMTP / Email Service (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM_ADDRESS=noreply@yourdomain.com

# -----------------------------------------------------------------------------
# 5. Storefront & Portal Build Variables (Next.js)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=https://api.yourdomain.com
NEXT_PUBLIC_PORTAL_URL=https://admin.yourdomain.com
NEXT_PUBLIC_WIDGET_URL=
